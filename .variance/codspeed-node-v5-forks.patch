+/** The options a bench ran with, as tinybench resolved them (defaults included). */
+function tinybenchOptionsOf(bench: TinybenchWithTasks): TinybenchOptions {
+  return {
+    time: bench.time,
+    iterations: bench.iterations,
+    // A bench with warmup turned off keeps its warmup timings, so they'd
+    // otherwise be reported as if a warmup had run.
+    warmupTime: bench.warmup ? bench.warmupTime : 0,
+    warmupIterations: bench.warmup ? bench.warmupIterations : 0,
+  };
+}
+
+function samplesOf(task: TinybenchTask): number[] {
+  const samples = task.result?.latency.samples;
+  if (samples === undefined || samples.length === 0) {
+    throw new Error(`[CodSpeed] "${task.name}" recorded no samples`);
+  }
+  // Copied: the parent writes them out, tinybench keeps its own array.
+  return [...samples];
+}
+
+/**
+ * Forks parent. Runs each benchmark in `forks` fresh processes, one after the
+ * other, and reports the rounds of all of them together. The parent runs
+ * neither warmup nor measurement: every fork warms up and measures the
+ * benchmark itself, with the options given to `bench().run()`.
+ */
+async function runWalltimeForks(
+  registrations: BenchRegistrationInput[],
+  options: BenchRunOptions | undefined,
+  getUri: (name: string) => string,
+  test: BenchmarkGroup["test"],
+  forks: number,
+): Promise<BenchResult[]> {
+  const filepath = test.file?.filepath;
+  if (!filepath) {
+    throw new Error("[CodSpeed] could not resolve the running benchmark file");
+  }
+  const { Bench } = await importHostTinybench();
+  // Never run: it only resolves tinybench's options, defaults included.
+  const resolved = tinybenchOptionsOf(
+    new Bench({ signal: test.context.signal, ...options, retainSamples: true }),
+  );
+
+  const benchmarks: Benchmark[] = [];
+  const results: BenchResult[] = [];
+  for (const { name } of registrations) {
+    const uri = getUri(name);
+    const samples = runForksOfFile(uri, forks, filepath);
+    if (samples.length === 0) {
+      throw new Error(`[CodSpeed] the forks of "${uri}" recorded no samples`);
+    }
+    const latency = statisticsOf(samples);
+    const totalTime = samples.reduce((sum, sample) => sum + sample, 0);
+    const benchmark = tinybenchTaskToBenchmark(
+      { name, result: { state: "completed", totalTime, latency } },
+      uri,
+      resolved,
+    );
+    if (benchmark) {
+      benchmarks.push(benchmark);
+    }
+    results.push({
+      ...analysisResult(name),
+      latency,
+      throughput: statisticsOf(samples.map((sample) => 1000 / sample)),
+      period: latency.mean,
+      totalTime,
+    });
+  }
+
+  writeAndLogWalltimeResults(benchmarks);
+  return results;
+}
+
+/**
+ * `runForks` re-runs the recorded benchmark command for every fork. Every fork
+ * only needs the file of its benchmark, so that is the one it is told to load
+ * instead of collecting all benchmark files for a single benchmark.
+ */
+function runForksOfFile(
+  uri: string,
+  forks: number,
+  filepath: string,
+): number[] {
+  const recorded = process.env[ISOLATION_COMMAND_ENV];
+  if (recorded === undefined) {
+    throw new Error(`[CodSpeed] ${ISOLATION_COMMAND_ENV} is not set`);
+  }
+  const command = JSON.parse(recorded) as string[];
+  process.env[ISOLATION_COMMAND_ENV] = JSON.stringify([...command, filepath]);
+  try {
+    return runForks(uri, forks);
+  } finally {
+    process.env[ISOLATION_COMMAND_ENV] = recorded;
+  }
+}
+
+/**
+ * Latency statistics of `samples` (milliseconds) for Vitest's reporter. Only
+ * the reporter reads the derived fields: CodSpeed's results come from the raw
+ * samples.
+ */
+function statisticsOf(samples: number[]): BenchStatistics {
+  const sorted = [...samples].sort((a, b) => a - b);
+  const count = sorted.length;
+  const mean = sorted.reduce((sum, sample) => sum + sample, 0) / count;
+  const df = count - 1;
+  const variance =
+    df > 0
+      ? sorted.reduce((sum, sample) => sum + (sample - mean) ** 2, 0) / df
+      : 0;
+  const sd = Math.sqrt(variance);
+  const sem = sd / Math.sqrt(count);
+  // Two-sided 95% Student's t critical value, approximated from above.
+  const critical = df > 0 ? 1.96 + 2.4 / df : 0;
+  const moe = critical * sem;
+  const percentile = (p: number) =>
+    sorted[Math.min(count - 1, Math.floor(p * count))];
+  const median = percentile(0.5);
+  const deviations = sorted
+    .map((sample) => Math.abs(sample - median))
+    .sort((a, b) => a - b);
+  return {
+    aad:
+      sorted.reduce((sum, sample) => sum + Math.abs(sample - mean), 0) / count,
+    critical,
+    df,
+    mad: deviations[Math.floor(count / 2)],
+    max: sorted[count - 1],
+    mean,
+    min: sorted[0],
+    moe,
+    p50: median,
+    p75: percentile(0.75),
+    p99: percentile(0.99),
+    p995: percentile(0.995),
+    p999: percentile(0.999),
+    rme: mean === 0 ? Infinity : (100 * moe) / Math.abs(mean),
+    samples: sorted as BenchStatistics["samples"],
+    samplesCount: count,
+    sd,
+    sem,
+    variance,
+  };
+}
